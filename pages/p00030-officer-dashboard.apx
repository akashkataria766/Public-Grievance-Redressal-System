page 30 (
    name: Officer Dashboard
    alias: OFFICER-DASHBOARD
    title: Officer Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region officer-dashboard (
        name: Officer Dashboard
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    COMPLAINT_ID,
                    DEPT_NAME,
                    STATUS_CODE,
                    CREATED_AT,
                    DUE_DATE,
                    IS_ESCALATED,
                    ASSIGNED_OFFICER_ID
                FROM V_PGRS_ACTIVE_COMPLAINTS
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 145392501797521937464
        }

        column ASSIGNED_OFFICER_ID (
            type: plainText
            heading {
                heading: Assigned Officer Id
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column COMPLAINT_ID (
            type: link
            heading {
                heading: Complaint Id
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            link {
                target: {
                    page: 31
                    items: {
                        P31_COMPLAINT_ID: #COMPLAINT_ID#
                    }
                }
                linkText: #COMPLAINT_ID#
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column CREATED_AT (
            type: plainText
            heading {
                heading: Created At
            }
            layout {
                sequence: 4
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column DEPT_NAME (
            type: plainText
            heading {
                heading: Dept Name
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column DUE_DATE (
            type: plainText
            heading {
                heading: Due Date
            }
            layout {
                sequence: 5
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column IS_ESCALATED (
            type: plainText
            heading {
                heading: Is Escalated
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column STATUS_CODE (
            type: plainText
            heading {
                heading: Status Code
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Officer Dashboard
        }

        savedReport 1453937318 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ASSIGNED_OFFICER_ID (
                sequence: 7
            )

            displayColumn COMPLAINT_ID (
                sequence: 1
            )

            displayColumn CREATED_AT (
                sequence: 4
            )

            displayColumn DEPT_NAME (
                sequence: 2
            )

            displayColumn DUE_DATE (
                sequence: 5
            )

            displayColumn IS_ESCALATED (
                sequence: 6
            )

            displayColumn STATUS_CODE (
                sequence: 3
            )

        )

    )

)

