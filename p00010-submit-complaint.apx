page 10 (
    name: Submit Complaint
    alias: SUBMIT-COMPLAINT
    title: Submit Complaint
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region complaint-form (
        name: Complaint Form
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P10_CITIZEN_ID (
        type: numberField
        label {
            label: Citizen ID
            alignment: left
        }
        layout {
            sequence: 10
            region: @complaint-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P10_DEPT_ID (
        type: selectList
        label {
            label: Dept ID
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT dept_name, dept_id
                FROM pgrs_departments
                ORDER BY dept_name
                ```
            nullDisplayValue: -- Select Department --
        }
        cascadingLov {
            parentItems: P10_DESCRIPTION
            itemsToSubmit: P10_DESCRIPTION
        }
        layout {
            sequence: 20
            region: @complaint-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P10_DESCRIPTION (
        type: textarea
        label {
            label: Complaint Description
            alignment: left
        }
        layout {
            sequence: 40
            region: @complaint-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P10_EVIDENCE (
        type: textarea
        label {
            label: Evidence Diary
            alignment: left
        }
        layout {
            sequence: 60
            region: @complaint-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
    )

    pageItem P10_LOCATION (
        type: textField
        label {
            label: Location
            alignment: left
        }
        layout {
            sequence: 50
            region: @complaint-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P10_TITLE (
        type: textField
        label {
            label: Title
            alignment: left
        }
        layout {
            sequence: 30
            region: @complaint-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button submit-complaint (
        buttonName: SUBMIT_COMPLAINT
        label: Submit Complaint
        layout {
            sequence: 70
            region: @complaint-form
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process create-complaint (
        name: CREATE_COMPLAINT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_complaint_id NUMBER;
                BEGIN
                
                    PGRS_CREATE_COMPLAINT(
                        P_CITIZEN_ID   => :P10_CITIZEN_ID,
                        P_DEPT_ID      => :P10_DEPT_ID,
                        P_TITLE        => :P10_TITLE,
                        P_DESCRIPTION  => :P10_DESCRIPTION,
                        P_LOCATION     => :P10_LOCATION,
                        P_COMPLAINT_ID => v_complaint_id
                    );
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        successMessage {
            successMessage: Complaint submitted successfully. Your complaint ID will be generated by the system.
        }
        advanced {
            executionMappingIdentifier: 126500586118479925834
        }
        serverSideCondition {
            whenButtonPressed: @submit-complaint
        }
    )

    branch (
        name: Reset Complaint Form
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 10
                clearCache: 10
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit-complaint
        }
    )

)

