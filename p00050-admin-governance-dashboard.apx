page 50 (
    name: ADMIN GOVERNANCE DASHBOARD
    alias: ADMIN-GOVERNANCE-DASHBOARD
    title: ADMIN GOVERNANCE DASHBOARD
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region department-complaint-distribution (
        name: Department Complaint Distribution
        title: Department Complaint Distribution
        type: chart
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chartLayout {
            height: 400
        }
        legend {
            show: false
        }

        series complaints-per-department (
            name: Complaints per Department
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        dept_name,
                        total_complaints
                    FROM
                        V_PGRS_DEPARTMENT_METRICS
                    ORDER BY
                        total_complaints DESC
                    ```
            }
            columnMapping {
                label: DEPT_NAME
                value: TOTAL_COMPLAINTS
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

        axis x (
            name: x
            title: Department
            title {
                fontColor: #000000
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Complaint Count
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region escalation-trend-monitor (
        name: Escalation Trend Monitor
        title: Escalation Trend Monitor
        type: chart
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: line
        }
        chartLayout {
            height: 400
        }
        legend {
            show: false
        }

        series escalations (
            name: Escalations
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        total_escalations,
                        escalation_month
                    FROM
                        V_PGRS_ESCALATION_TREND
                    ORDER BY
                        escalation_month
                    ```
            }
            columnMapping {
                label: ESCALATION_MONTH
                value: TOTAL_ESCALATIONS
            }
        )

        axis x (
            name: x
            title: Escalation Month
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Escalation Count
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region officer-stage-delay-intelligence (
        name: Officer Stage Delay intelligence
        title: Officer Stage Delay Intelligence
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                SELECT
                    OFFICER_ID,
                    OFFICER_NAME,
                    AVG_ASSIGNED_REACTION_DAYS,
                    AVG_IN_PROGRESS_DAYS,
                    AVG_VERIFICATION_DAYS,
                    MEASURED_COMPLAINTS
                FROM
                    V_PGRS_OFFICER_STAGE_DELAY
                ORDER BY
                    AVG_ASSIGNED_REACTION_DAYS DESC
                ```
        }
        layout {
            sequence: 90
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 148106739214914645832
        }

        column AVG_ASSIGNED_REACTION_DAYS (
            type: plainText
            heading {
                heading: Avg Assigned Reaction Days
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column AVG_IN_PROGRESS_DAYS (
            type: plainText
            heading {
                heading: Avg In Progress Days
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column AVG_VERIFICATION_DAYS (
            type: plainText
            heading {
                heading: Avg Verification Days
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column MEASURED_COMPLAINTS (
            type: plainText
            heading {
                heading: Measured Complaints
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column OFFICER_ID (
            type: plainText
            heading {
                heading: Officer Id
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column OFFICER_NAME (
            type: plainText
            heading {
                heading: Officer Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Officer Stage Delay Intelligence
        }

        savedReport 1483914600 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AVG_ASSIGNED_REACTION_DAYS (
                sequence: 3
            )

            displayColumn AVG_IN_PROGRESS_DAYS (
                sequence: 4
            )

            displayColumn AVG_VERIFICATION_DAYS (
                sequence: 5
            )

            displayColumn MEASURED_COMPLAINTS (
                sequence: 6
            )

            displayColumn OFFICER_ID (
                sequence: 1
            )

            displayColumn OFFICER_NAME (
                sequence: 2
            )

        )

    )

