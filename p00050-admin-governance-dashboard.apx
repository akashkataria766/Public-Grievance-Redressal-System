    region sla-risk-monitor (
        name: SLA Risk Monitor
        title: SLA Risk Monitor
        type: chart
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        value {
            formatScaling: none
        }
        legend {
            position: bottom
        }

        series sla-risk (
            name: SLA Risk
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 'Safe' AS status, COUNT(*) AS total
                    FROM V_PGRS_SLA_METRICS
                    
                    UNION ALL
                    
                    SELECT 'Near Breach', COUNT(*)
                    FROM V_PGRS_NEAR_SLA_BREACH
                    
                    UNION ALL
                    
                    SELECT 'Breached', COUNT(*)
                    FROM V_PGRS_SLA_BREACH
                    ```
            }
            columnMapping {
                label: STATUS
                value: TOTAL
            }
        )

    )

    region system-health-overview (
        name: System Health Overview
        title: System Health Overview
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    metric_name,
                    metric_value,
                    metric_icon
                FROM
                (
                    SELECT
                        'Total Complaints' metric_name,
                        total_complaints metric_value,
                        'fa-database' metric_icon
                    FROM V_PGRS_SYSTEM_OVERVIEW
                
                    UNION ALL
                
                    SELECT
                        'Active Complaints',
                        active_complaints,
                        'fa-tasks'
                    FROM V_PGRS_SYSTEM_OVERVIEW
                
                    UNION ALL
                
                    SELECT
                        'Closed Complaints',
                        closed_complaints,
                        'fa-check-circle'
                    FROM V_PGRS_SYSTEM_OVERVIEW
                
                    UNION ALL
                
                    SELECT
                        'Escalated Cases',
                        escalated_complaints,
                        'fa-exclamation-triangle'
                    FROM V_PGRS_SYSTEM_OVERVIEW
                
                    UNION ALL
                
                    SELECT
                        'Verification Pending',
                        verification_pending,
                        'fa-clock'
                    FROM V_PGRS_SYSTEM_OVERVIEW
                )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
                t-Form--large
            ]
        }
        componentAppearance {
            gridColumns: 5
        }
        title {
            column: METRIC_NAME
        }
        subtitle {
            column: METRIC_VALUE
        }
        iconAndBadge {
            iconSource: iconClassColumn
            iconColumn: METRIC_ICON
        }
    )

)

