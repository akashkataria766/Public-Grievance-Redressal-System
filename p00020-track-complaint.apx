page 20 (
    name: Track Complaint
    alias: TRACK-COMPLAINT
    title: Track Complaint
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region complaint-timeline (
        name: Complaint Timeline
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    a.complaint_id,
                    u.full_name        AS citizen_name,
                    d.dept_name        AS department,
                    s.status_code      AS status,
                    a.title,
                    a.description,
                    a.location_desc,
                    a.created_at,
                    a.due_date,
                    a.is_escalated,
                    o.full_name        AS assigned_officer
                FROM pgrs_complaints a
                LEFT JOIN pgrs_users u
                       ON u.user_id = a.citizen_id
                LEFT JOIN pgrs_departments d
                       ON d.dept_id = a.dept_id
                LEFT JOIN pgrs_status_manager s
                       ON s.status_id = a.status_id
                LEFT JOIN pgrs_users o
                       ON o.user_id = a.assigned_officer_id
                WHERE a.complaint_id = :P20_COMPLAINT_ID
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P20_COMPLAINT_ID
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 126500587277579925845
        }

        column ASSIGNED_OFFICER (
            type: plainText
            heading {
                heading: Assigned Officer
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column CITIZEN_NAME (
            type: plainText
            heading {
                heading: Citizen Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column COMPLAINT_ID (
            type: plainText
            heading {
                heading: Complaint Id
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column CREATED_AT (
            type: plainText
            heading {
                heading: Created At
            }
            layout {
                sequence: 80
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: H
            }
        )

        column DEPARTMENT (
            type: plainText
            heading {
                heading: Department
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column DUE_DATE (
            type: plainText
            heading {
                heading: Due Date
            }
            layout {
                sequence: 90
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: I
            }
        )

        column IS_ESCALATED (
            type: plainText
            heading {
                heading: Is Escalated
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column LOCATION_DESC (
            type: plainText
            heading {
                heading: Location Desc
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column TITLE (
            type: plainText
            heading {
                heading: Title
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region search-complaint (
        name: Search Complaint
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P20_COMPLAINT_ID (
        type: numberField
        label {
            label: Enter Complaint ID
            alignment: left
        }
        layout {
            sequence: 10
            region: @search-complaint
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button search-complaint (
        buttonName: SEARCH_COMPLAINT
        label: Track Complaint
        layout {
            sequence: 20
            region: @search-complaint
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

