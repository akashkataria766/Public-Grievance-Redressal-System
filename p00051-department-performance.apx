page 51 (
    name: Department Performance
    alias: DEPARTMENT-PERFORMANCE
    title: Department Performance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region department-complaint-trend (
        name: Department Complaint Trend
        title: Department Complaint Trend
        type: chart
        source {
            pageItemsToSubmit: P51_DEPT_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: line
        }
        chartLayout {
            height: 400
        }
        legend {
            show: false
        }

        series complaint-trend (
            name: Complaint Trend
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        TRUNC(created_at) AS complaint_date,
                        COUNT(*) AS total_complaints
                    FROM
                        PGRS_COMPLAINTS
                    WHERE
                        dept_id = :P51_DEPT_ID
                    GROUP BY
                        TRUNC(created_at)
                    ORDER BY
                        complaint_date
                    ```
            }
            columnMapping {
                label: COMPLAINT_DATE
                value: TOTAL_COMPLAINTS
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region department-overview (
        name: Department Overview
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    'Total Complaints' AS label,
                    COUNT(*) AS value,
                    'fa-database' AS icon
                FROM PGRS_COMPLAINTS
                WHERE dept_id = NVL(:P51_DEPT_ID, dept_id)
                
                UNION ALL
                
                SELECT
                    'Active',
                    COUNT(*),
                    'fa-tasks'
                FROM PGRS_COMPLAINTS
                WHERE dept_id = NVL(:P51_DEPT_ID, dept_id)
                AND status_id IN (1,21,22,41)
                
                UNION ALL
                
                SELECT
                    'Resolved',
                    COUNT(*),
                    'fa-check-circle'
                FROM PGRS_COMPLAINTS
                WHERE dept_id = NVL(:P51_DEPT_ID, dept_id)
                AND status_id = 23
                
                UNION ALL
                
                SELECT
                    'Escalated',
                    COUNT(*),
                    'fa-exclamation-triangle'
                FROM PGRS_COMPLAINTS
                WHERE dept_id = NVL(:P51_DEPT_ID, dept_id)
                AND NVL(is_escalated, 'N') = 'Y'
                ```
            pageItemsToSubmit: P51_DEPT_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        componentAppearance {
            gridColumns: 4
        }
        title {
            column: LABEL
        }
        body {
            column: VALUE
        }
        iconAndBadge {
            iconSource: iconClassColumn
            iconColumn: ICON
        }
    )

    pageItem P51_DEPT_ID (
        type: selectList
        label {
            label: Select Department
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT dept_name, dept_id
                FROM PGRS_DEPARTMENTS
                WHERE is_active = 'Y'
                ORDER BY dept_name
                ```
            nullDisplayValue: -- Select Department --
        }
        layout {
            sequence: 10
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P51_DEPT_ID
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @department-overview
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P51_DEPT_ID
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @department-complaint-trend
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

